      "cardName": "Exclusion",
      "showFieldType": true,
      "showDescription": false,
      "supportsAllProducts": false
    },
    {
      "yamlValue": "AnnotatePolicy",
      "controlType": "Annotations",
      "dataControlOutput": "AnnotationData",
      "fieldControlName": "annotationField",
      "defaultFields": "Annotations",
      "cardName": "Annotate",
